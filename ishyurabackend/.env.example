# Twilio Live Credentials for Real SMS OTP Delivery
# Obtain these from your Twilio Console (https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Optional: Twilio Verify Service SID (if using Twilio Verify API)
TWILIO_VERIFY_SERVICE_SID=

# Security & CORS
JWT_SECRET_KEY=replace-with-a-random-32-character-secret
CORS_ORIGINS=https://your-domain.pages.dev,http://localhost:3000,http://localhost:5173
PORT=8000
