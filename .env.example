# -------------------------------------------------------------
# Twilio Real SMS OTP Delivery Configuration for Physical Devices
# Supports Rwandan Networks (+250 MTN Rwanda, Airtel Rwanda) & International
# -------------------------------------------------------------

# Twilio Master Account Credentials
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Twilio Verify Service SID
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid_here

# Frontend Backend Target (Cloudflare Worker / Express server)
VITE_BACKEND_URL=

# Admin signing secret (REQUIRED, min 16 chars). Signs admin session tokens and doubles as a
# break-glass admin key. Generate one with: openssl rand -base64 32
# Production: `npx wrangler secret put ADMIN_SECRET`. Local dev: put it in .dev.vars.
ADMIN_SECRET=

# Optional: separate key for signing sessions (defaults to ADMIN_SECRET; min 16 chars)
SESSION_SECRET=

# LOCAL DEV ONLY: set to "true" to accept the fixed OTP 123456 for non-admin phones and to have
# /auth/request-otp return it. Never set this in production.
ALLOW_TEST_OTP=

# Optional: extra Google OAuth client IDs accepted when verifying Google sign-in (comma-separated)
GOOGLE_CLIENT_IDS=
